nav.p-4.bg-mist-400.shadow.flex.items-center
    .flex-grow-1.text-blue-600.font-bold
        a.mx-1(href=`/${locale}`)= __("nav.home")
        a.mx-1(href=`/${locale}/about`)= __("nav.about")
        a.mx-1(href=`/${locale}/articles`)= __("nav.articles")
        a.mx-1(href=`/${locale}/contact`)= __("nav.contact")
    div.text-sm.text-gray-500
        if locale === "fr"
            a.mx-1(href="/en") English
        else
            a.mx-1(href="/fr") Français
