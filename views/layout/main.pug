doctype html
html(lang=locale)
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="description", content= __("meta.description"))
        title #{title} - #{__("site.title")}

        if languages && languages.length
            each availableLang in languages
                link(rel="alternate", hreflang=availableLang, href=`${siteUrl}/${availableLang}${localizedPath}`)
            link(rel="alternate", hreflang="x-default", href=`${siteUrl}/${defaultLang || 'fr'}${localizedPath}`)

        link(rel="stylesheet", href="/styles/style.css")
        script(type="module", src="/scripts/main.js")
        block scripts
    body.bg-gray-100.text-gray-900
        include ../includes/nav.pug

        main.container.mx-auto.p-6
            block content
